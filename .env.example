# Copie para `.env` e preencha. O `.env` está no .gitignore — não commite segredos.
# Tudo aqui é OPCIONAL: sem as chaves, o pipeline roda em modo "mock/dry-run"
# (não envia nada, não chama serviços pagos). Você liga cada integração trocando
# o provedor no config/config.yaml E preenchendo a chave correspondente aqui.

# --- Personalização (Claude API) ---
# Sem isto, a personalização cai para o template renderizado (sem LLM).
ANTHROPIC_API_KEY=

# --- Provedor de dados (sourcing) ---
ECONODATA_API_KEY=
SPEEDIO_API_KEY=
DATASTONE_API_KEY=

# --- Verificador de e-mail ---
NEVERBOUNCE_API_KEY=
ZEROBOUNCE_API_KEY=
HUNTER_API_KEY=

# --- Envio de e-mail ---
# SMTP (para envio direto / testes). Gmail: use uma "senha de app", não a senha normal.
SMTP_USUARIO=
SMTP_SENHA=
# Ferramentas de cold email (opcional, escala):
INSTANTLY_API_KEY=
SMARTLEAD_API_KEY=
SENDGRID_API_KEY=
